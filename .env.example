# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# On Vercel, add the same keys under Project → Settings → Environment Variables.
#
# The site builds and deploys with none of these set — both are optional.
# ---------------------------------------------------------------------------

# Canonical URL of the deployed site. Used for metadata, canonical tags,
# sitemap.xml, robots.txt and Open Graph URLs.
# Change this if you add a custom domain later — nothing else needs editing.
NEXT_PUBLIC_SITE_URL=https://princekanswal.vercel.app

# Contact form destination. Optional — leave it out and the form sends to the
# address in src/data/site.ts (profile.email) with no configuration at all.
#
# Set it only if you want to hide that address from the page source. After the
# first submission is confirmed, FormSubmit emails you a random string; paste
# that string here (not a full URL — just the string).
NEXT_PUBLIC_FORMSUBMIT_TARGET=
