# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# On Vercel, add the same keys under Project → Settings → Environment Variables.
#
# The site builds and deploys with none of these set — all are optional.
# ---------------------------------------------------------------------------

# Canonical URL of the deployed site. Used for metadata, canonical tags,
# sitemap.xml, robots.txt and Open Graph URLs.
# Change this if you add a custom domain later — nothing else needs editing.
NEXT_PUBLIC_SITE_URL=https://princekanswal.vercel.app

# --- Contact form ----------------------------------------------------------
#
# The form delivers through whichever providers are configured, tried in order,
# so a provider being down costs a retry rather than the message. If every one
# fails, the visitor is offered a pre-filled message in their own mail client —
# see src/lib/contact.ts.
#
# Strongly recommended. Web3Forms is free, needs no server, and has a dashboard
# where you can see submissions — which matters, because a form that silently
# drops messages looks exactly like a form nobody is using.
#
# Get a key by entering your address at https://web3forms.com; it arrives by
# email. Set it here and Web3Forms becomes the primary provider.
NEXT_PUBLIC_WEB3FORMS_KEY=

# FormSubmit (https://formsubmit.co). Used automatically whenever no Web3Forms
# key is set, and as the fallback when one is. The destination is simply the
# address in src/data/site.ts, so there is nothing required here.
#
# Note: FormSubmit's first submission must be confirmed by clicking a link it
# emails you, and its backend has had extended outages during which its
# homepage kept answering normally. The dashboard-free nature of it is why
# Web3Forms is the recommended primary.
#
# Optional, and only useful once a submission has been confirmed: FormSubmit
# then emails you a random string that stands in for your address. Paste that
# string here (just the string, not a URL) to keep the address out of the page
# source.
NEXT_PUBLIC_FORMSUBMIT_TARGET=
